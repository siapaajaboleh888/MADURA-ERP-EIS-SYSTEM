# Madura ERP / EIS Environment Configuration

# Backend Configuration
APP_NAME="Madura ERP"
APP_ENV=local
APP_KEY=base64:sometestingkeygeneratedbyartisan=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=madura_erp
DB_USERNAME=madura_user
DB_PASSWORD=secret_password

# Educational Mode
LAB_MODE=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
